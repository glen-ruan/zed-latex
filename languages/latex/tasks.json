[
  {
    "label": "XeLaTeX (latexmk)",
    "command": "latexmk",
    "args": [
      "-xelatex",
      "-cd",
      "-synctex=1",
      "-interaction=nonstopmode",
      "-file-line-error",
      "-halt-on-error",
      "-recorder",
      "-outdir=build",
      "$ZED_FILENAME"
    ],
    "cwd": "$ZED_DIRNAME",
    "tags": [
      "latex-build"
    ],
    "save": "all",
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "XeLaTeX (latexmk, watch)",
    "command": "latexmk",
    "args": [
      "-xelatex",
      "-cd",
      "-pvc",
      "-synctex=1",
      "-interaction=nonstopmode",
      "-file-line-error",
      "-recorder",
      "-outdir=build",
      "$ZED_FILENAME"
    ],
    "cwd": "$ZED_DIRNAME",
    "tags": [
      "latex-build"
    ],
    "save": "all",
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "latexmk",
    "command": "latexmk",
    "args": [
      "-synctex=1",
      "-e",
      "\"\\$pdf_mode = 1 unless \\$pdf_mode != 0;\"",
      "-recorder",
      "$ZED_FILENAME"
    ],
    "cwd": "$ZED_DIRNAME",
    "tags": [
      "latex-build"
    ]
  },
  {
    "label": "latexmk (watch)",
    "command": "latexmk",
    "args": [
      "-pvc",
      "-synctex=1",
      "-e",
      "\"\\$pdf_mode = 1 unless \\$pdf_mode != 0;\"",
      "-recorder",
      "$ZED_FILENAME"
    ],
    "cwd": "$ZED_DIRNAME",
    "tags": [
      "latex-build"
    ]
  },
  {
    "label": "pdflatex",
    "command": "pdflatex",
    "args": [
      "-synctex=1",
      "-recorder",
      "$ZED_FILENAME"
    ],
    "cwd": "$ZED_DIRNAME",
    "tags": [
      "latex-build"
    ]
  },
  {
    "label": "lualatex",
    "command": "lualatex",
    "args": [
      "--synctex=1",
      "--recorder",
      "$ZED_FILENAME"
    ],
    "cwd": "$ZED_DIRNAME",
    "tags": [
      "latex-build"
    ]
  }
]
